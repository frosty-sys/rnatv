        <activity
            android:name=".RnaAiActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|navigation"
            android:label="RNA AI"
            android:theme="@style/Theme.MyApplication" />

        <!-- Translucent Standalone Overlay Activity for Remapped Recent Apps Drawer & Quick All-Apps Taskbar -->
